# ==============================================================================
# CASEBRIDGE AI — FASTAPI BACKEND CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL or SQLite fallback for offline development)
DATABASE_URL=sqlite:///./casebridge.db
# In Supabase production:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT Security
JWT_SECRET_KEY=casebridge-production-secret-key-replace-in-env-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase Integration (Optional if connecting directly via service role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
