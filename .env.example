# ==============================================================================
# CASEBRIDGE AI — ENVIRONMENT CONFIGURATION
# SIH 2026 | Problem Statement: SIH26264
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FASTAPI_BACKEND_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. Supabase Managed Backend Configuration
# Obtain these credentials from your Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client components)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (RESTRICTED: Never expose to browser or client bundles!)
# Required strictly for server-side Next.js route handlers & trusted background operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Direct PostgreSQL Connection String (Optional for direct DB access / Alembic)
# Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. Storage Bucket Configuration
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET=complaint-attachments

# ------------------------------------------------------------------------------
# 5. Security & Authentication Configuration
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
